# Bu dosyayı ".env" adıyla kopyalayıp değiştirebilirsin. Boş bırakırsan varsayılanlar kullanılır.
# DATABASE_URL=sqlite:///./kahvecell.db

# Canlıya çıkarken MUTLAKA uzun, rastgele bir değerle değiştir (en az 32 karakter).
# SECRET_KEY=buraya-uzun-rastgele-bir-metin
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=7

# SMS simülasyonu için sabit kod
# OTP_CODE=1234

# Frontend'in adresi (CORS izni). Virgülle birden fazla adres yazılabilir.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
